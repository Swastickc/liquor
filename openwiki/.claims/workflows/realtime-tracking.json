        }
      ]
    },
    {
      "id": "claim_55595fc812d84cb785c15c74f7216816",
      "statement": "On connect each socket joins its personal room named by socket.user.userId; joining an order room via joinOrder is gated by a server-side ownership check (SEC-5) — the requester must be the order's user, the assigned deliveryPartner, or an admin/restaurant_owner resolved from the User collection, otherwise the join is denied.",
      "evidence": [
