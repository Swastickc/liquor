  "claims": [
    {
      "id": "claim_3ca6a5853a6d4425b4c16035c0312941",
      "statement": "Socket.io on backend/server.js attaches io to every request (req.io) and authenticates each connection with an io.use middleware: token from handshake.auth.token first (cookie jwt fallback for cross-origin WebSocket), reject if missing or longer than 1000 chars, then jwt.verify against JWT_SECRET, storing the decoded payload as socket.user; the handshake CORS is an explicit origin allowlist with the wildcard .vercel.app match removed (SEC-7).",
      "evidence": [
        {
          "resource": "repo://backend/server.js#L121-L142",
          "version": "repo-lines-v1:sha256:ab792b44ba214b3170f10bff658efcce75fd4912a4a29e0f0d49094deb2e8e54:"
        },
