    {
      "id": "claim_9bf691787b44479eb8c368dd64ff83ef",
      "statement": "Razorpay verification (POST /api/v1/payment/verify) stacks five checks: HMAC-SHA256 signature of razorpay_order_id|razorpay_payment_id with RAZORPAY_KEY_SECRET, server-side fetch of the Razorpay order whose notes.orderId must match the internal order id, payment status captured/authorized, ownership and exact amount equality with the DB order's totalPrice, and idempotent no-op if already paid; createRazorpayOrder reads the amount from the DB order (SEC-1), never from the client.",
      "evidence": [
        {
          "resource": "repo://backend/controllers/paymentController.js#L38-L75",
          "version": "repo-lines-v1:sha256:0dc683209925e21969a1fc38180571893b69abc97aa91310d38dcc63b3a6e55d:"
