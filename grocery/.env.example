# Grocery frontend uses the existing Render backend through Vercel's same-origin proxy.
# Set this only once /api/grocery/health is deployed and verified.
VITE_GROCERY_API=/api/grocery
# Existing Render service already owns MONGO_URI, JWT_SECRET, Razorpay,
# Cloudinary and Brevo/SMTP settings. Do not copy secrets into VITE_ variables.
# Add on Render after test-mode verification:
# GROCERY_CHECKOUT_ENABLED=false
# GROCERY_RAZORPAY_WEBHOOK_SECRET=<secret configured for /api/grocery/webhook>
